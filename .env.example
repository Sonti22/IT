# Copy to .env for local testing. NEVER commit .env.
# In GitHub Actions, store these as repository secrets instead.

TG_BOT_TOKEN=123456789:AA...replace-with-token-from-BotFather
TG_CHANNEL_ID=-1001234567890

# Set at least ONE LLM provider. Bot tries them in order: Groq → Gemini → Claude.
# Groq is recommended for $0 budget (free, global, fast). Get key at console.groq.com.
GROQ_API_KEY=gsk_...
# GEMINI_API_KEY=AIza...
# ANTHROPIC_API_KEY=sk-ant-...
